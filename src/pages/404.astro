---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations, getLangFromPath, getLocalePath } from '../i18n/index';

// Rendered on demand so the requested path is available: Vercel sends every
// unmatched URL here, and only the real request tells us whether the visitor
// was under /en/ or not.
export const prerender = false;

const lang = getLangFromPath(Astro.url.pathname);
const t = useTranslations(lang);
---

<BaseLayout
  title={`${t.notFound.metaTitle} — ${t.meta.siteName}`}
  description={t.notFound.description}
  lang={lang}
  noindex
  langSwitchHref={lang === 'it' ? '/en/' : '/'}
>
  <section class="min-h-[70vh] flex items-center justify-center section-padding">
    <div class="text-center space-y-6 max-w-3xl px-6">
      <p class="font-display text-8xl lg:text-9xl text-brand-border leading-none">404</p>
      <h1 class="font-display text-brand-text">
        {t.notFound.title}
      </h1>
      <p class="text-brand-muted leading-relaxed max-w-md mx-auto">
        {t.notFound.body}
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
        <a href={getLocalePath(lang, '/')} class="btn-solid">
          {t.notFound.home}
        </a>
        <a href={getLocalePath(lang, '/apartments')} class="btn-outline">
          {t.notFound.apartments}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
