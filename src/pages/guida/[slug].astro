---
import { getCollection } from 'astro:content';
import GuideArticle from '../../components/guida/GuideArticle.astro';

export async function getStaticPaths() {
  const entries = await getCollection('guida', e => e.data.lang === 'it');
  return entries.map(entry => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---

<GuideArticle lang="it" entry={entry} />
