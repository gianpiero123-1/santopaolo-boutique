---
import type { Lang } from '../../i18n/index';
import { OPS_COPY } from '../../lib/operations';

/**
 * The Operations brief form, posting JSON to /api/brief. Used by the hub and
 * by the production page; `extended` adds the production-specific fields
 * (project duration, vehicles by type).
 */
interface Props {
  lang: Lang;
  extended?: boolean;
  /** False hides the internal h2, for pages that render their own heading above the form. */
  showHeading?: boolean;
}

const { lang, extended = false, showHeading = true } = Astro.props;
const c = OPS_COPY[lang];

const inputClass =
  'w-full bg-brand-bg border border-brand-border text-brand-text px-3 py-2.5 text-sm focus:outline-none focus:border-brand-accent transition-colors';
const labelClass = 'block text-[10px] uppercase tracking-wider text-brand-muted mb-1';
---

<section id="brief" class="section-padding scroll-mt-32">
  <div class="max-w-7xl mx-auto px-6 lg:px-8 space-y-8">
    {showHeading && (
      <h2 class="font-display text-3xl lg:text-4xl text-brand-text tracking-tight">{c.form.title}</h2>
    )}

    <div class="max-w-3xl">
      <form id="brief-form" class="space-y-6" novalidate>
        <div
          id="brief-error"
          hidden
          class="border border-brand-accent-hover bg-brand-bg2 px-4 py-3 text-sm text-[#D9A0A0]"
          role="alert"
        >
          {c.form.error}
        </div>

        <fieldset class="border border-brand-border bg-brand-bg2 p-5 lg:p-6 space-y-5">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <label class="block">
              <span class={labelClass}>{c.form.name}</span>
              <input type="text" name="name" autocomplete="name" maxlength="200" class={inputClass} required />
            </label>
            <label class="block">
              <span class={labelClass}>{c.form.company}</span>
              <input type="text" name="company" autocomplete="organization" maxlength="200" class={inputClass} />
            </label>
            <label class="block">
              <span class={labelClass}>{c.form.email}</span>
              <input type="email" name="email" autocomplete="email" maxlength="200" class={inputClass} required />
            </label>
            <label class="block">
              <span class={labelClass}>{c.form.phone}</span>
              <input type="tel" name="phone" autocomplete="tel" maxlength="50" class={inputClass} />
            </label>
            <label class="block">
              <span class={labelClass}>{c.form.dates}</span>
              <input type="text" name="dates" maxlength="200" class={inputClass} />
            </label>
            {extended && (
              <label class="block">
                <span class={labelClass}>{c.form.projectDuration}</span>
                <input type="text" name="project_duration" maxlength="200" class={inputClass} />
              </label>
            )}
            <label class="block">
              <span class={labelClass}>{c.form.guests}</span>
              <input type="number" name="guests" min="1" max="200" class={inputClass} />
            </label>
            <label class="block">
              <span class={labelClass}>{c.form.vehicles}</span>
              <input type="text" name="vehicles" maxlength="200" class={inputClass} />
            </label>
            <label class="block">
              <span class={labelClass}>{c.form.projectType}</span>
              <select name="project_type" class={inputClass}>
                {c.form.projectTypes.map(option => (
                  <option value={option}>{option}</option>
                ))}
              </select>
            </label>
            <label class="block">
              <span class={labelClass}>{c.form.storage}</span>
              <select name="storage" class={inputClass}>
                {c.form.storageOptions.map(option => (
                  <option value={option}>{option}</option>
                ))}
              </select>
            </label>
            <label class="block">
              <span class={labelClass}>{c.form.budget}</span>
              <input type="text" name="budget" maxlength="200" class={inputClass} />
            </label>
          </div>

          {extended && (
            <label class="block">
              <span class={labelClass}>{c.form.vehiclesByType}</span>
              <textarea name="vehicles_by_type" rows="3" maxlength="1000" class={`${inputClass} resize-y`}></textarea>
            </label>
          )}

          <div>
            <span class={labelClass}>{c.form.services}</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 mt-2">
              {c.categories.map(category => (
                <label class="flex items-center gap-2.5 text-brand-muted text-sm cursor-pointer">
                  <input
                    type="checkbox"
                    name="services"
                    value={category.label}
                    class="accent-[#6B1F1F] w-4 h-4 bg-brand-bg border border-brand-border"
                  />
                  {category.label}
                </label>
              ))}
            </div>
          </div>

          <label class="block">
            <span class={labelClass}>{c.form.notes}</span>
            <textarea name="notes" rows="5" maxlength="3000" class={`${inputClass} resize-y`}></textarea>
          </label>
        </fieldset>

        <button
          type="submit"
          id="brief-submit"
          class="btn-solid w-full py-4 hover:bg-brand-accent-hover hover:opacity-100"
          data-label={c.form.submit}
          data-sending={c.form.sending}
        >
          {c.form.submit}
        </button>
      </form>

      <div
        id="brief-success"
        hidden
        class="border border-brand-border bg-brand-bg2 p-8 lg:p-10 text-center"
      >
        <p class="text-brand-text text-lg">{c.form.success}</p>
      </div>

      <div class="mt-8 pt-6 border-t border-brand-border space-y-1.5">
        <p class="nav-link">{c.form.directContact}</p>
        <p class="text-brand-muted text-sm">
          <a
            href="https://wa.me/393313225577"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-brand-text transition-colors"
          >WhatsApp +39 331 322 5577</a>
        </p>
        <p class="text-brand-muted text-sm">
          <a
            href="mailto:gianpiero@santopaoloboutiqueapartments.com"
            class="hover:text-brand-text transition-colors"
          >gianpiero@santopaoloboutiqueapartments.com</a>
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('brief-form') as HTMLFormElement | null;
  const errorBox = document.getElementById('brief-error');
  const successBox = document.getElementById('brief-success');
  const submit = document.getElementById('brief-submit') as HTMLButtonElement | null;

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!form.reportValidity() || !submit) return;

    errorBox?.setAttribute('hidden', '');
    submit.disabled = true;
    submit.textContent = submit.dataset.sending ?? '';

    const data = new FormData(form);
    const payload: Record<string, unknown> = {};
    for (const [key, value] of data.entries()) {
      if (key === 'services') continue;
      payload[key] = value;
    }
    payload.services = data.getAll('services');
    payload.lang = document.documentElement.lang;

    try {
      const res = await fetch('/api/brief', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(String(res.status));
      form.setAttribute('hidden', '');
      successBox?.removeAttribute('hidden');
    } catch {
      errorBox?.removeAttribute('hidden');
      submit.disabled = false;
      submit.textContent = submit.dataset.label ?? '';
    }
  });
</script>
