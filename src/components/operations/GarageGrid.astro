---
/**
 * Asymmetric photo grid for the garage, five slots: a 2fr 16:9 slot and a 1fr
 * 8:9 slot on the first row (same resolved height), three equal 4:3 slots on
 * the second. Each slot renders the image when `src` is set and a dark
 * labelled placeholder otherwise, so the photos can be dropped in one by one
 * without touching the layout: add `src` (and `alt`) to the item in the page
 * that renders this component.
 */
export interface GarageGridItem {
  label: string;
  src?: string;
  alt?: string;
}

interface Props {
  items: GarageGridItem[];
}

const { items } = Astro.props;

/** Column span (of 6) and aspect ratio per slot, in grid order. */
const SLOTS = [
  { span: 'col-span-4', aspect: '16 / 9' },
  { span: 'col-span-2', aspect: '8 / 9' },
  { span: 'col-span-2', aspect: '4 / 3' },
  { span: 'col-span-2', aspect: '4 / 3' },
  { span: 'col-span-2', aspect: '4 / 3' },
];
---

<ul class="grid grid-cols-6 gap-2.5">
  {items.map((item, index) => (
    <li
      class={`relative overflow-hidden bg-[#171717] border border-brand-border/60 ${SLOTS[index].span}`}
      style={`aspect-ratio: ${SLOTS[index].aspect};`}
    >
      {item.src ? (
        <img
          src={item.src}
          alt={item.alt ?? item.label}
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
      ) : (
        <span class="absolute bottom-2.5 left-3 right-3 font-mono text-[10px] md:text-[11px] tracking-[0.2em] uppercase text-[#5C5955]">
          {item.label}
        </span>
      )}
    </li>
  ))}
</ul>
