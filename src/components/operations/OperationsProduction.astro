  /* ═══ MOTION ═══ */
  .rv { opacity: 0; transform: translateY(26px); transition: opacity 0.9s cubic-bezier(0.2, 0.7, 0.3, 1), transform 0.9s cubic-bezier(0.2, 0.7, 0.3, 1); }
  .rv.in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    .rv { opacity: 1; transform: none; transition: none; }
    .shafts span, .ticker .track { animation: none; }
    .band:hover { transform: none; }
  }
  @media (max-width: 899px) {
    .band { margin: 0 !important; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveal on scroll.
  const revealed = document.querySelectorAll<HTMLElement>('.rv');
  if (!('IntersectionObserver' in window) || reduce) {
    revealed.forEach(el => el.classList.add('in'));
  } else {
    const io = new IntersectionObserver(
      entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in');
            io.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.14, rootMargin: '0px 0px -6% 0px' }
    );
    revealed.forEach(el => io.observe(el));
  }

  // Sticky index of the scope section.
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.panel'));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.idx button'));

  function mark(index: number): void {
    panels.forEach((panel, i) => panel.classList.toggle('live', i === index));
    buttons.forEach((button, i) => button.classList.toggle('on', i === index));
  }

  if (panels.length) {
    mark(0);
    if ('IntersectionObserver' in window) {
      const po = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            if (entry.isIntersecting) mark(panels.indexOf(entry.target as HTMLElement));
          });
        },
        { threshold: 0.5, rootMargin: '-25% 0px -25% 0px' }
      );
      panels.forEach(panel => po.observe(panel));
    }
    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const target = panels[Number(button.dataset.go)];
        target?.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
      });
    });
  }

  // Brief form, JSON to /api/brief with three button states: ready, sending, sent.
  const form = document.getElementById('production-brief') as HTMLFormElement | null;
  const submit = document.getElementById('production-brief-submit') as HTMLButtonElement | null;
  const submitText = submit?.querySelector<HTMLElement>('[data-text]') ?? null;
  const errorLine = document.getElementById('production-brief-error');

  form?.addEventListener('submit', async event => {
    event.preventDefault();
    if (!submit || !submitText || submit.disabled) return;

    errorLine?.setAttribute('hidden', '');
    submit.disabled = true;
    submitText.textContent = submit.dataset.sending ?? '';

    const payload: Record<string, unknown> = {};
    for (const [key, value] of new FormData(form).entries()) payload[key] = value;
    payload.lang = document.documentElement.lang;

    try {
      const res = await fetch('/api/brief', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(String(res.status));
      submitText.textContent = submit.dataset.sent ?? '';
    } catch {
      errorLine?.removeAttribute('hidden');
      submit.disabled = false;
      submitText.textContent = submit.dataset.label ?? '';
    }
  });
</script>
