  .contact dd { margin: 8px 0 0; font-size: 16px; color: var(--text); line-height: 1.5; }
  .contact dd a { color: inherit; text-decoration: none; border-bottom: 1px solid var(--hair2); transition: border-color 0.35s ease; overflow-wrap: anywhere; }
  .contact dd a:hover { border-color: var(--accent-hover); }
  .contact .hint { margin-top: 26px; font-size: 13.5px; color: var(--marble); max-width: 32ch; line-height: 1.6; }

  .form { display: grid; gap: clamp(20px, 2.4vw, 32px) clamp(20px, 3vw, 44px); }
  @media (min-width: 720px) { .form { grid-template-columns: 1fr 1fr; } }
  .field { display: flex; flex-direction: column; gap: 10px; }
