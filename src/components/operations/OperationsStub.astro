---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Lang } from '../../i18n/index';
import { OPS_COPY, opsPath, type OpsStubSlug } from '../../lib/operations';

/** Placeholder page for the Operations subsections, content to follow. */
interface Props {
  lang: Lang;
  slug: OpsStubSlug;
}

const { lang, slug } = Astro.props;
const c = OPS_COPY[lang];
const stub = c.stubs[slug];
---

{/* Noindex until real content lands; internal links keep passing (follow).
    Must stay in sync with NOINDEX_ROUTES in astro.config.mjs. */}
<BaseLayout
  title={`${stub.name} — Santopaolo Hospitality & Logistics`}
  description={stub.description}
  lang={lang}
  noindex
>
  <section class="section-padding">
    <div class="max-w-7xl mx-auto px-6 lg:px-8 space-y-6">
      <p class="nav-link">Santopaolo Hospitality & Logistics</p>
      <h1 class="font-display text-4xl lg:text-6xl text-brand-text tracking-tight">
        {stub.name}
      </h1>
      <p class="text-brand-muted text-lg">{c.stub.inPreparation}</p>
      <p>
        <a
          href={opsPath(lang)}
          class="text-brand-muted text-sm hover:text-brand-text transition-colors"
        >
          {c.stub.back}
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
