---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuideCard from './GuideCard.astro';
import InPractice from './InPractice.astro';
import type { Lang } from '../../i18n/index';
import { useTranslations, getLocalePath, getGuidePath } from '../../i18n/index';
import { GUIDE_COPY, formatGuideDate } from '../../lib/guida';

/** The guide article template, shared by /guida/[slug] and /en/guide/[slug]. */
interface Props {
  lang: Lang;
  entry: CollectionEntry<'guida'>;
}

const { lang, entry } = Astro.props;
const { data } = entry;
const t = useTranslations(lang);
const copy = GUIDE_COPY[lang];
const otherLang: Lang = lang === 'it' ? 'en' : 'it';

const { Content } = await render(entry);

// Related cards resolve against the collection at build time: a slug with no
// article yet is dropped instead of becoming a dead card.
const siblings = await getCollection('guida', e => e.data.lang === lang);
const related = data.related
  .map(slug => siblings.find(e => e.data.slug === slug))
  .filter((e): e is CollectionEntry<'guida'> => Boolean(e));

// Hreflang only when the counterpart exists; the language toggle falls back
// to the other language's hub for untranslated articles.
const hasPair = Boolean(data.translationSlug);
const alternatePath = hasPair
  ? `${getGuidePath(otherLang)}/${data.translationSlug}/`
  : undefined;
const langSwitchHref = hasPair
  ? `${getGuidePath(otherLang)}/${data.translationSlug}`
  : getGuidePath(otherLang);

const updatedDate = data.updatedDate ?? data.publishDate;
const isoDate = (d: Date) => d.toISOString().split('T')[0];
---

<BaseLayout
  title={`${data.title} | ${t.meta.siteName}`}
  description={data.description}
  lang={lang}
  ogType="article"
  hasAlternate={hasPair}
  alternatePath={alternatePath}
  langSwitchHref={langSwitchHref}
  breadcrumbLeafLabel={data.title}
  guideArticle={{
    headline: data.title,
    answer: data.answer,
    datePublished: isoDate(data.publishDate),
    dateModified: data.updatedDate ? isoDate(data.updatedDate) : undefined,
    mentions: data.mentions,
  }}
>
  <article class="px-6 py-12 lg:py-16">
    <div class="max-w-[68ch] mx-auto">
      <nav aria-label={copy.breadcrumbLabel} class="text-xs text-brand-muted mb-6">
        <a href={getLocalePath(lang, '/')} class="hover:text-brand-text transition-colors">Home</a><span aria-hidden="true" class="mr-1.5">,</span>
        <a href={getGuidePath(lang)} class="hover:text-brand-text transition-colors">{copy.hubTitle}</a><span aria-hidden="true" class="mr-1.5">,</span>
        <span class="text-brand-text">{data.title}</span>
      </nav>

      <h1 class="font-display text-[clamp(28px,5vw,40px)] leading-[1.15] text-brand-text tracking-tight mb-6">
        {data.title}
      </h1>

      <p class="bg-brand-bg2 border-l-2 border-brand-accent py-5 px-6 text-[17px] leading-[1.6] text-brand-text mb-8">
        {data.answer}
      </p>

      <div class="guide-prose">
        <Content components={{ InPractice }} />
      </div>

      {data.propertyLink && (
        <a
          href={data.propertyLink.href}
          class="block bg-brand-bg2 p-6 mt-10 border-l-2 border-transparent transition-[border-color] duration-150 hover:border-brand-accent"
        >
          <p class="text-[11px] uppercase tracking-[0.14em] text-brand-muted">
            Santopaolo Boutique Apartments
          </p>
          <p class="mt-2 font-display font-light text-lg text-brand-text">
            {data.propertyLink.label}
          </p>
          <p class="mt-2 text-sm text-brand-muted" aria-hidden="true">→</p>
        </a>
      )}

      {related.length > 0 && (
        <div class="mt-10 pt-8 border-t border-[#1C1C1C]">
          <h2 class="font-display font-light text-[22px] text-brand-text tracking-tight">
            {copy.related}
          </h2>
          <div class="mt-5 grid grid-cols-1 gap-4">
            {related.map(r => (
              <GuideCard lang={lang} entry={r} />
            ))}
          </div>
        </div>
      )}

      <footer class="mt-10">
        <p class="text-xs text-brand-muted">
          {copy.updated} <time datetime={isoDate(updatedDate)}>{formatGuideDate(lang, updatedDate)}</time>
        </p>
        <p class="mt-2 text-[13px] text-brand-muted">{copy.brandLine}</p>
      </footer>
    </div>
  </article>
</BaseLayout>

<style is:global>
  /* MDX body: slotted content, so scoped styles would not reach it. */
  .guide-prose {
    font-size: 1rem;
    line-height: 1.75;
    color: rgba(245, 242, 236, 0.88);
  }

  .guide-prose > * + * {
    margin-top: 1.25rem;
  }

  .guide-prose h2 {
    font-size: 1.375rem;
    /* At 22px the global weight 200 is too thin on the dark ground. */
    font-weight: 300;
    color: #f5f2ec;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .guide-prose h2 + * {
    margin-top: 0.75rem;
  }

  .guide-prose h3 {
    font-size: 1.25rem;
    color: #f5f2ec;
    margin-top: 2rem;
  }

  .guide-prose a {
    color: #f5f2ec;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: #6b1f1f;
    text-underline-offset: 3px;
    transition: text-decoration-color 0.15s ease;
  }

  .guide-prose a:hover {
    text-decoration-color: #8a2a2a;
  }

  .guide-prose ul,
  .guide-prose ol {
    padding-left: 1.25rem;
  }

  .guide-prose li + li {
    margin-top: 0.5rem;
  }

  .guide-prose ul li::marker {
    color: #6b1f1f;
  }

  .guide-prose strong {
    color: #f5f2ec;
    font-weight: 600;
  }

  .guide-prose blockquote {
    border-left: 2px solid #2a2a2a;
    padding-left: 1.25rem;
    color: #8a8580;
  }
</style>
