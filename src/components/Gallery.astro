---
import type { Lang } from '../i18n/index';

/**
 * Photo grid with a full-screen lightbox, no dependencies. The grid shows the
 * 800px thumbnails, the lightbox the 2000px files (WebP with JPG fallback).
 * Keyboard: Esc closes, arrow keys navigate. Touch: horizontal swipe. The
 * sequence loops, so next on the last photo returns to the first.
 */
export interface GalleryImage {
  /** 2000px JPG, lightbox fallback and og:image. */
  src: string;
  /** 2000px WebP, served in the lightbox where supported. */
  webp: string;
  /** 800px WebP for the grid. */
  thumb: string;
  alt: { it: string; en: string } | string;
  room: string;
}

interface Props {
  images: GalleryImage[];
  lang?: Lang;
  title?: string;
  subtitle?: string;
}

const { images, lang = 'it', title, subtitle } = Astro.props;

const LABELS: Record<Lang, { open: string; close: string; prev: string; next: string; dialog: string }> = {
  it: { open: 'Apri la foto', close: 'Chiudi', prev: 'Foto precedente', next: 'Foto successiva', dialog: 'Galleria a schermo intero' },
  en: { open: 'Open photo', close: 'Close', prev: 'Previous photo', next: 'Next photo', dialog: 'Full screen gallery' },
};
const labels = LABELS[lang];

const altOf = (img: GalleryImage): string => (typeof img.alt === 'string' ? img.alt : img.alt[lang]);

// What the client script needs per photo. `<` is escaped so an alt can never
// close the JSON script element early.
const payload = JSON.stringify(images.map(img => ({ src: img.src, webp: img.webp, alt: altOf(img) }))).replace(/</g, '\\u003c');

const icon = 'fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"';
---

<section class="space-y-5" data-gallery>
  {title && (
    <div class="space-y-1">
      <h2 class="font-display text-brand-text">{title}</h2>
      {subtitle && <p class="text-brand-muted text-sm">{subtitle}</p>}
    </div>
  )}

  <div class="grid grid-cols-2 lg:grid-cols-3 gap-2">
    {images.map((img, i) => (
      <button
        type="button"
        class="group block aspect-[4/3] overflow-hidden bg-brand-bg2 cursor-zoom-in focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-accent"
        data-gallery-item
        data-index={i}
        aria-label={`${labels.open}, ${i + 1} / ${images.length}`}
      >
        <img
          src={img.thumb}
          alt={altOf(img)}
          width="800"
          height="600"
          loading={i < 3 ? 'eager' : 'lazy'}
          decoding="async"
          class="w-full h-full object-cover transition-opacity duration-300 group-hover:opacity-[0.85]"
        />
      </button>
    ))}
  </div>

  <div
    class="fixed inset-0 z-[200] hidden items-center justify-center bg-[rgba(14,14,14,0.95)] outline-none"
    data-gallery-lightbox
    hidden
    role="dialog"
    aria-modal="true"
    aria-label={labels.dialog}
    tabindex="-1"
  >
    <button
      type="button"
      class="absolute top-4 right-4 lg:top-6 lg:right-6 p-2 text-brand-text hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-text"
      data-gallery-close
      aria-label={labels.close}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" set:html={`<g ${icon}><path d="M18 6 6 18" /><path d="m6 6 12 12" /></g>`} aria-hidden="true" />
    </button>

    <button
      type="button"
      class="absolute left-2 lg:left-6 top-1/2 -translate-y-1/2 p-2 text-brand-text hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-text"
      data-gallery-prev
      aria-label={labels.prev}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" set:html={`<g ${icon}><path d="m15 18-6-6 6-6" /></g>`} aria-hidden="true" />
    </button>

    <figure class="m-0 pointer-events-none flex items-center justify-center">
      <picture>
        <source type="image/webp" srcset="" data-gallery-webp />
        <img src="" alt="" class="block max-w-[90vw] max-h-[90vh] object-contain select-none pointer-events-auto" data-gallery-img />
      </picture>
    </figure>

    <button
      type="button"
      class="absolute right-2 lg:right-6 top-1/2 -translate-y-1/2 p-2 text-brand-text hover:opacity-80 transition-opacity focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-text"
      data-gallery-next
      aria-label={labels.next}
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" set:html={`<g ${icon}><path d="m9 18 6-6-6-6" /></g>`} aria-hidden="true" />
    </button>

    <p class="absolute bottom-5 left-1/2 -translate-x-1/2 font-mono text-xs tracking-[0.06em] text-brand-muted" data-gallery-counter aria-live="polite">
      1 / {images.length}
    </p>
  </div>

  <script is:inline type="application/json" data-gallery-data set:html={payload} />
</section>

<script>
  interface Item {
    src: string;
    webp: string;
    alt: string;
  }

  const SWIPE_MIN_PX = 40;

  function initGallery(root: HTMLElement): void {
    const dataEl = root.querySelector<HTMLScriptElement>('[data-gallery-data]');
    const lightbox = root.querySelector<HTMLElement>('[data-gallery-lightbox]');
    const img = root.querySelector<HTMLImageElement>('[data-gallery-img]');
    const webp = root.querySelector<HTMLSourceElement>('[data-gallery-webp]');
    const counter = root.querySelector<HTMLElement>('[data-gallery-counter]');
    if (!dataEl || !lightbox || !img || !webp || !counter) return;

    const items: Item[] = JSON.parse(dataEl.textContent || '[]');
    if (items.length === 0) return;

    let index = 0;
    let lastFocus: HTMLElement | null = null;
    let touchX = 0;
    let touchY = 0;

    const wrap = (i: number): number => (i + items.length) % items.length;

    // Warm the neighbours so arrow presses feel instant.
    const preload = (i: number): void => {
      const warm = new Image();
      warm.src = items[wrap(i)].webp;
    };

    const show = (i: number): void => {
      index = wrap(i);
      const item = items[index];
      webp.srcset = item.webp;
      img.src = item.src;
      img.alt = item.alt;
      counter.textContent = `${index + 1} / ${items.length}`;
      preload(index + 1);
      preload(index - 1);
    };

    const open = (i: number): void => {
      lastFocus = document.activeElement as HTMLElement | null;
      show(i);
      lightbox.hidden = false;
      lightbox.classList.replace('hidden', 'flex');
      document.body.style.overflow = 'hidden';
      lightbox.focus();
    };

    const close = (): void => {
      lightbox.hidden = true;
      lightbox.classList.replace('flex', 'hidden');
      document.body.style.overflow = '';
      lastFocus?.focus();
    };

    root.querySelectorAll<HTMLButtonElement>('[data-gallery-item]').forEach(btn => {
      btn.addEventListener('click', () => open(Number(btn.dataset.index)));
    });
    root.querySelector('[data-gallery-close]')?.addEventListener('click', close);
    root.querySelector('[data-gallery-prev]')?.addEventListener('click', () => show(index - 1));
    root.querySelector('[data-gallery-next]')?.addEventListener('click', () => show(index + 1));

    // The figure ignores pointer events, so a click anywhere outside the photo
    // and the controls reaches the backdrop and closes.
    lightbox.addEventListener('click', event => {
      if (event.target === lightbox) close();
    });

    document.addEventListener('keydown', event => {
      if (lightbox.hidden) return;
      if (event.key === 'Escape') close();
      else if (event.key === 'ArrowRight') show(index + 1);
      else if (event.key === 'ArrowLeft') show(index - 1);
    });

    lightbox.addEventListener(
      'touchstart',
      event => {
        touchX = event.changedTouches[0].clientX;
        touchY = event.changedTouches[0].clientY;
      },
      { passive: true },
    );
    lightbox.addEventListener(
      'touchend',
      event => {
        const dx = event.changedTouches[0].clientX - touchX;
        const dy = event.changedTouches[0].clientY - touchY;
        if (Math.abs(dx) < SWIPE_MIN_PX || Math.abs(dx) < Math.abs(dy)) return;
        show(dx < 0 ? index + 1 : index - 1);
      },
      { passive: true },
    );
  }

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(initGallery);
</script>
