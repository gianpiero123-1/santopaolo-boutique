---
import type { Lang } from '../i18n/index';
import { useTranslations, getRequestPath } from '../i18n/index';

/**
 * Sidebar card on the apartment pages. No instant booking and no exposed
 * prices: it sends the guest to the booking request form, preselecting the
 * unit via ?app=N when the page passes one.
 */
interface Props {
  appNumber?: number;
  lang?: Lang;
}

const { appNumber, lang = 'it' } = Astro.props;
const tr = useTranslations(lang);
const whatsappHref = `https://wa.me/393313225577?text=${encodeURIComponent(tr.whatsapp.defaultMessage)}`;

const requestHref = appNumber
  ? `${getRequestPath(lang)}?app=${appNumber}`
  : getRequestPath(lang);

const t = {
  it: {
    title: 'Soggiorno su misura',
    body: 'Ogni preventivo è personalizzato in base al periodo, alla durata del soggiorno e al numero di ospiti. Rispondiamo entro 2 ore, dalle 9 alle 22.',
    cta: 'Richiedi un preventivo',
    whatsapp: 'Scrivici su WhatsApp',
  },
  en: {
    title: 'A tailored stay',
    body: 'Every quote is tailored to the dates, length of stay and number of guests. We reply within 2 hours, 9am to 10pm.',
    cta: 'Request a quote',
    whatsapp: 'Write to us on WhatsApp',
  },
}[lang];
---

<div class="rounded-sm border border-brand-border bg-brand-bg2 p-6 space-y-5">
  <p class="text-xs uppercase tracking-wider text-brand-muted">
    {t.title}
  </p>

  <p class="text-brand-muted text-sm leading-relaxed">
    {t.body}
  </p>

  <a
    href={requestHref}
    class="block w-full text-center bg-brand-accent hover:bg-[#8A2A2A] text-brand-text uppercase tracking-wider text-xs py-3.5 transition-colors"
  >
    {t.cta}
  </a>

  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="block w-full text-center border border-brand-accent text-brand-accent hover:bg-brand-accent hover:text-brand-text uppercase tracking-wider text-xs py-3.5 transition-colors"
  >
    {t.whatsapp}
  </a>
</div>
