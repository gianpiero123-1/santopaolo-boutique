---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import JsonLd from '../components/JsonLd.astro';
import type { Lang } from '../i18n/index';
import { buildPageGraph, type GuideArticleGraphOptions } from '../data/schema';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  lang?: Lang;
  ogImage?: string;
  canonicalURL?: string;
  /**
   * Skips canonical + hreflang and asks crawlers not to index (noindex,follow).
   * For the 404 and the Operations stub pages.
   */
  noindex?: boolean;
  /** Overrides where the language toggle points, for pages with no counterpart. */
  langSwitchHref?: string;
  /**
   * Overrides the computed hreflang alternate path, for route pairs whose
   * slugs differ across languages (/richiesta vs /en/request).
   */
  alternatePath?: string;
  /**
   * False on pages with no counterpart in the other language (an untranslated
   * guide article): skips the hreflang links so they never point at a 404.
   */
  hasAlternate?: boolean;
  /** Slug of the unit on an apartment detail page, so the graph can name it. */
  apartmentSlug?: string;
  /** CollectionPage on listing hubs (the guide index); WebPage everywhere else. */
  pageType?: 'WebPage' | 'CollectionPage';
  /** Names the final breadcrumb segment when it is a dynamic slug. */
  breadcrumbLeafLabel?: string;
  /** Adds Article + FAQPage nodes to the graph on guide article pages. */
  guideArticle?: GuideArticleGraphOptions;
}

const {
  title,
  description,
  lang = 'it',
  // TODO: create /public/og-image.png (1200×630) — bg #0E0E0E, logo 200px centered, "Santopaolo Boutique Apartments" Fraunces white 48px, "Chiaia, Napoli" Inter #8A8580 18px uppercase letter-spacing 0.3em
  ogImage = '/og-image.png',
  canonicalURL: canonicalOverride,
  noindex = false,
  langSwitchHref,
  alternatePath: alternatePathOverride,
  hasAlternate = true,
  apartmentSlug,
  pageType,
  breadcrumbLeafLabel,
  guideArticle,
} = Astro.props;

const siteName = 'Santopaolo Boutique Apartments';
const siteURL = (Astro.site?.href ?? 'https://www.santopaoloapartments.com/').replace(/\/$/, '');
// Built from `site` rather than Astro.url so the canonical host stays www even
// when a page is rendered on demand and the request arrives on the bare domain.
const canonicalURL = canonicalOverride ?? `${siteURL}${Astro.url.pathname}`;
const alternateLang = lang === 'it' ? 'en' : 'it';
// Language-only BCP 47 tags, deliberately identical to the sitemap's i18n
// locales and to `inLanguage` in the JSON-LD graph. No region subtag: there is
// a single version per language, so "en" reaches every English speaker rather
// than only the UK. A region subtag would only be right with several regional
// variants of the same language. Note og:locale below is a different spec and
// keeps its it_IT / en_GB form on purpose.
const BCP47: Record<Lang, string> = { it: 'it', en: 'en' };
const alternatePath = alternatePathOverride ?? (lang === 'en'
  ? Astro.url.pathname.replace(/^\/en/, '') || '/'
  : `/en${Astro.url.pathname}`);
const alternateURL = `${siteURL}${alternatePath}`;

// One @graph per page, built here so no page can forget it or emit a second
// block. Skipped on noindex routes (the 404), which have nothing to describe.
const jsonLd = noindex
  ? null
  : buildPageGraph({
      lang,
      pathname: Astro.url.pathname,
      title,
      description,
      apartmentSlug,
      pageType,
      breadcrumbLeafLabel,
      guideArticle,
    });
---

<!doctype html>
<html lang={BCP47[lang]} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />

    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <Fragment>
        <link rel="canonical" href={canonicalURL} />

        {hasAlternate && (
          <Fragment>
            <!-- Hreflang -->
            <link rel="alternate" hreflang={BCP47.it} href={lang === 'it' ? canonicalURL : alternateURL} />
            <link rel="alternate" hreflang={BCP47.en} href={lang === 'en' ? canonicalURL : alternateURL} />
            <link rel="alternate" hreflang="x-default" href={lang === 'it' ? canonicalURL : alternateURL} />
          </Fragment>
        )}
      </Fragment>
    )}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={`${siteURL}${ogImage}`} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    <meta property="og:locale:alternate" content={alternateLang === 'it' ? 'it_IT' : 'en_GB'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteURL}${ogImage}`} />

    <!-- Structured data -->
    {jsonLd && <JsonLd data={jsonLd} />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Google Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,200;0,9..144,300;0,9..144,400;0,9..144,500;1,9..144,400;1,9..144,500&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <slot name="head" />
  </head>
  <body class="bg-brand-bg text-brand-text min-h-screen flex flex-col">
    <Navbar lang={lang} langSwitchHref={langSwitchHref} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <WhatsAppFloat phone="+393313225577" lang={lang} />
    <Analytics />
  </body>
</html>
